{
  "name": "hirescope-backend",
  "version": "1.0.0",
  "description": "HireScope Backend — Express + TypeScript + MongoDB. Interview prep kit generation pipeline.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "evaluate": "tsx scripts/evaluate.ts",
    "test": "jest --runInBand",
    "test:unit": "jest --testPathPattern=tests/unit",
    "test:integration": "jest --testPathPattern=tests/integration",
    "lint": "eslint src/ --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^4.21.0",
    "cors": "^2.8.5",
    "helmet": "^8.0.0",
    "express-session": "^1.18.1",
    "connect-mongo": "^5.1.0",
    "mongoose": "^8.8.0",
    "zod": "^3.24.0",
    "bcryptjs": "^2.4.3",
    "nanoid": "^5.0.9",
    "cheerio": "^1.0.0",
    "robotstxt-parser": "^0.0.7",
    "express-rate-limit": "^7.4.0",
    "winston": "^3.17.0",
    "dotenv": "^16.4.7",
    "@google/generative-ai": "^0.21.0",
    "groq-sdk": "^0.8.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "tsx": "^4.19.0",
    "@types/node": "^22.0.0",
    "@types/express": "^5.0.0",
    "@types/cors": "^2.8.17",
    "@types/express-session": "^1.18.1",
    "@types/bcryptjs": "^2.4.6",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.0",
    "@types/jest": "^29.5.0",
    "eslint": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
